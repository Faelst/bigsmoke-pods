# Admin criado automaticamente no primeiro login em /admin/login
ADMIN_EMAIL=admin@bigsmokepods.com
ADMIN_PASSWORD=troque-esta-senha

# Banco de dados (obrigatório na Vercel/serverless). Sem ela, usa o arquivo data/db.json.
# Na Vercel: Storage → Create Database → Neon (Postgres) — a variável é criada sozinha.
# DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

# Mercado Pago (PIX e cartão de crédito) — Suas integrações → sua aplicação → Credenciais.
# Use as credenciais de teste em desenvolvimento/preview e as de produção só em Production.
NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000
# Webhooks → Configurar notificações → evento "Order (Mercado Pago)": copie a assinatura secreta.
MP_WEBHOOK_SECRET=
